{
  "id": "mauerbrecher",
  "name": { "de": "Mauerbrecher", "en": "Wall Breaker" },
  "version": "0.3.1",
  "description": {
    "de": "Mit dem Schläger einen Ball gegen eine Mauer aus Steinen schießen und sie in 10 Leveln zerschlagen",
    "en": "Bounce a ball off your paddle against a wall of bricks and smash it in 10 levels"
  },
  "repository": "https://github.com/hearthbit/gamehearth-mauerbrecher",
  "languages": [
    "de",
    "en"
  ],
  "cover": "cover.svg",
  "sdk": "^0.1.6",
  "license": {
    "code": "MIT",
    "assets": "CC0-1.0"
  },
  "mode": "single",
  "players": {
    "min": 1,
    "max": 1
  },
  "server": false,
  "client": "dist/client",
  "roles": {
    "player": {
      "inputs": [
        "touch",
        "keyboard"
      ],
      "screen": "small"
    }
  },
  "stats": {
    "punkte": {
      "label": {
        "de": "Punkte",
        "en": "Points"
      },
      "better": "higher",
      "format": "number"
    }
  }
}
